---
import SiteLayout from "../layouts/SiteLayout.astro";
import { languages } from "../data/languages.js";

export function getStaticPaths() {
  return languages.map((language) => ({
    params: { language: language.slug },
    props: { language },
  }));
}

const { language } = Astro.props;
const pageTitle = `${language.name} Scripture`;
---

<SiteLayout
  title={pageTitle}
  description={`Explore Cambodia Bible Scripture resources in ${language.name}.`}
>
  <section class="content-section language-detail">
    <a class="back-link" href="/">← All languages</a>
    <article class="resource-panel">
      <img
        class="resource-icon"
        src="/logoimage512.png"
        alt=""
        width="112"
        height="112"
      />
      <p class="eyebrow">Language resources</p>
      <h2>{language.name}</h2>
      <p>
        Explore Scripture resources in {language.name}. More information and
        resources for this language will be shared here.
      </p>
      {
        language.slug === "jarai" && (
          <div class="resource-actions">
            <a
              class="button"
              href="https://play.google.com/store/apps/details?id=app.cambodiabible.jra.jkb"
              target="_blank"
              rel="noreferrer"
            >
              JKB Jarai Bible on Google Play
            </a>
            <a
              class="text-link"
              href="https://apps.apple.com/th/app/jkb-jarai-bible/id6503242493"
              target="_blank"
              rel="noreferrer"
            >
              JKB Jarai Bible on the iPhone App Store
            </a>
          </div>
        )
      }
      {
        language.slug === "tampuan" && (
          <div class="resource-actions">
            <a
              class="button"
              href="https://play.google.com/store/apps/details?id=org.kalaam.cambodia.tampuan.tpu.bible&amp;pcampaignid=web_share"
              target="_blank"
              rel="noreferrer"
            >
              Tampuan Bible on Google Play
            </a>
            <a
              class="text-link"
              href="https://www.bible.com/app"
              target="_blank"
              rel="noreferrer"
            >
              YouVersion Bible app for iPhone and Android
            </a>
            <a
              class="text-link"
              href="https://tampuan.ipsapps.org/km"
              target="_blank"
              rel="noreferrer"
            >
              Read Tampuan Scripture online
            </a>
          </div>
        )
      }
    </article>
  </section>
</SiteLayout>
