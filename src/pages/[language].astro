---
import SiteLayout from "../layouts/SiteLayout.astro";
import { languages } from "../data/languages.js";

export function getStaticPaths() {
  return languages.map((language) => ({
    params: { language: language.slug },
    props: { language },
  }));
}

const { language } = Astro.props;
const pageTitle = `${language.name} Scripture`;
---

<SiteLayout
  title={pageTitle}
  description={`Explore Cambodia Bible Scripture resources in ${language.name}.`}
>
  <section class="content-section language-detail">
    <a class="back-link" href="/">← All languages</a>
    <article class="resource-panel">
      <img
        class="resource-icon"
        src="/logoimage512.png"
        alt=""
        width="112"
        height="112"
      />
      <p class="eyebrow">Language resources</p>
      <h2>{language.name}</h2>
      <p>
        Explore Scripture resources in {language.name}. More information and
        resources for this language will be shared here.
      </p>
      {
        language.slug === "jarai" && (
          <div class="resource-actions store-badges">
            <a
              class="store-badge store-badge--google"
              href="https://play.google.com/store/apps/details?id=app.cambodiabible.jra.jkb"
              target="_blank"
              rel="noreferrer"
            >
              <img
                src="/badges/google-play.png"
                alt="Get JKB Jarai Bible on Google Play"
                width="207"
                height="80"
              />
            </a>
            <a
              class="store-badge store-badge--apple"
              href="https://apps.apple.com/th/app/jkb-jarai-bible/id6503242493"
              target="_blank"
              rel="noreferrer"
            >
              <img
                src="/badges/app-store.svg"
                alt="Download JKB Jarai Bible on the App Store"
                width="162"
                height="54"
              />
            </a>
            <a
              class="store-badge store-badge--web"
              href="https://jarai.ipsapps.org"
              target="_blank"
              rel="noreferrer"
              aria-label="Read JKB Jarai Bible online"
            >
              <svg
                class="store-badge__icon"
                viewBox="0 0 24 24"
                aria-hidden="true"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
              >
                <circle cx="12" cy="12" r="9.5" />
                <path d="M2.5 12h19" />
                <path d="M12 2.5c2.6 2.6 4 6 4 9.5s-1.4 6.9-4 9.5c-2.6-2.6-4-6-4-9.5s1.4-6.9 4-9.5z" />
              </svg>
              <span class="store-badge__text">
                <span class="store-badge__small">Read it</span>
                <span class="store-badge__large">Online</span>
              </span>
            </a>
            <a
              class="store-badge store-badge--web"
              href="https://www.bible.com/bible/3656/MAT.1.JKB"
              target="_blank"
              rel="noreferrer"
              aria-label="Read JKB Jarai Bible on YouVersion"
            >
              <img
                class="store-badge__logo"
                src="/badges/youversion.png"
                alt=""
                width="34"
                height="34"
              />
              <span class="store-badge__text">
                <span class="store-badge__small">Read it on</span>
                <span class="store-badge__large">YouVersion</span>
              </span>
            </a>
          </div>
        )
      }
      {
        language.slug === "brao" && (
          <div class="resource-actions">
            <a
              class="button"
              href="https://www.bible.com/bible/2545/MAT.1.BRB"
              target="_blank"
              rel="noreferrer"
            >
              Read the Brao Bible on YouVersion
            </a>
          </div>
        )
      }
      {
        language.slug === "bunong" && (
          <div class="resource-actions">
            <a
              class="button"
              href="https://bvp-bunong.org"
              target="_blank"
              rel="noreferrer"
            >
              Visit the Bunong Bible website
            </a>
          </div>
        )
      }
      {
        language.slug === "cham" && (
          <div class="resource-actions">
            <a
              class="button"
              href="https://play.google.com/store/apps/details?id=org.fcbh.cjawyi.n1.n"
              target="_blank"
              rel="noreferrer"
            >
              Read Cham Bible on Google Play
            </a>
            <a
              class="text-link"
              href="https://cham.ipsapps.net/khm"
              target="_blank"
              rel="noreferrer"
            >
              Read Cham Scripture online
            </a>
          </div>
        )
      }
      {
        language.slug === "tampuan" && (
          <div class="resource-actions">
            <a
              class="button"
              href="https://play.google.com/store/apps/details?id=org.kalaam.cambodia.tampuan.tpu.bible&amp;pcampaignid=web_share"
              target="_blank"
              rel="noreferrer"
            >
              Tampuan Bible on Google Play
            </a>
            <a
              class="text-link"
              href="https://www.bible.com/app"
              target="_blank"
              rel="noreferrer"
            >
              YouVersion Bible app for iPhone and Android
            </a>
            <a
              class="text-link"
              href="https://tampuan.ipsapps.org/km"
              target="_blank"
              rel="noreferrer"
            >
              Read Tampuan Scripture online
            </a>
          </div>
        )
      }
    </article>
  </section>
</SiteLayout>
