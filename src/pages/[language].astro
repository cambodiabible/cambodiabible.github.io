---
import SiteLayout from "../layouts/SiteLayout.astro";
import StoreBadge from "../components/StoreBadge.astro";
import { languages } from "../data/languages.js";

export function getStaticPaths() {
  return languages.map((language) => ({
    params: { language: language.slug },
    props: { language },
  }));
}

const { language } = Astro.props;
const pageTitle = `${language.name} Scripture`;
---

<SiteLayout
  title={pageTitle}
  description={`Explore Cambodia Bible Scripture resources in ${language.name}.`}
>
  <section class="content-section language-detail">
    <a class="back-link" href="/">← All languages</a>
    <article class="resource-panel">
      <img
        class="resource-icon"
        src="/logoimage512.png"
        alt=""
        width="112"
        height="112"
      />
      <p class="eyebrow">Language resources</p>
      <h2>{language.name}</h2>
      <p>
        Explore Scripture resources in {language.name}. 
      </p>
      {
        language.slug === "jarai" && (
          <>
          <div class="resource-actions store-badges">
            <StoreBadge type="google" name="JKB Jarai Bible" href="https://play.google.com/store/apps/details?id=app.cambodiabible.jra.jkb" appTitle="JKB Jarai ព្រះគម្ពីរ​ចារាយ" developer="Cambodia Bible" />
            <StoreBadge type="apple" name="JKB Jarai Bible" href="https://apps.apple.com/th/app/jkb-jarai-bible/id6503242493" />
            <StoreBadge type="online" name="JKB Jarai Bible" href="https://jarai.ipsapps.org" />
            <StoreBadge type="youversion" name="JKB Jarai Bible" href="https://www.bible.com/bible/3656/MAT.1.JKB" />
          </div>
          <hr class="resource-divider" />
          <div class="resource-actions store-badges">
            <StoreBadge type="site" name="Jarai books" href="https://bloomlibrary.org/language:jra-Khmr-KH" logo="/badges/bloom.png" text="Bloom Library" color="#d9564a" />
            <StoreBadge type="site" name="Radio Jarai" label="Radio Jarai on Facebook" href="https://www.facebook.com/radiojarai" logo="/badges/facebook.svg" text="Radio Jarai" color="#0866FF" />
            <StoreBadge type="site" name="Jarai Bible" label="Jarai Bible on Facebook" href="https://www.facebook.com/JaraiBible" logo="/badges/facebook.svg" text="Jarai Bible" color="#0866FF" />
            <StoreBadge type="site" name="Jarai" label="An Jarai on Facebook" href="https://www.facebook.com/profile.php?id=100068847219492" logo="/badges/facebook.svg" text="An Jarai អាន ឆ្រៃ អាន ចារាយ" color="#0866FF" />
          </div>
          </>
        )
      }
      {
        language.slug === "brao" && (
          <div class="resource-actions store-badges">
            <StoreBadge type="youversion" name="the Brao Bible" href="https://www.bible.com/bible/2545/MAT.1.BRB" />
          </div>
        )
      }
      {
        language.slug === "bunong" && (
          <div class="resource-actions">
            <a
              class="button"
              href="https://bvp-bunong.org"
              target="_blank"
              rel="noreferrer"
            >
              Visit the Bunong Bible website
            </a>
          </div>
        )
      }
      {
        language.slug === "cham" && (
          <div class="resource-actions store-badges">
            <StoreBadge type="google" name="the Cham Bible" href="https://play.google.com/store/apps/details?id=org.fcbh.cjawyi.n1.n" appTitle="Cham, Western Bible" developer="Faith Comes By Hearing" />
            <StoreBadge type="online" name="Cham Scripture" href="https://cham.ipsapps.net/khm" />
            <StoreBadge type="bibleis" name="the Cham Bible" href="https://live.bible.is/bible/CJAWYI/MRK/1?audio_type=audio" />
            <StoreBadge type="google" name="Cham Kitab Injil Jawi Audio" href="https://play.google.com/store/apps/details?id=org.kalaam.cam.cja.kitab.injil.jawi" appTitle="Cham Kitab Injil Jawi Audio" developer="Kalaam Apps" />
            <StoreBadge type="google" name="Cham Kitab Injil Kakkhak" href="https://play.google.com/store/apps/details?id=org.kalaam.cham.cja.kitab.khkha.traditional" appTitle="Cham Kitab Injil Kakkhak" developer="Kalaam Apps" />
          </div>
        )
      }
      {
        language.slug === "tampuan" && (
          <>
          <div class="resource-actions store-badges">
            <StoreBadge type="google" name="the Tampuan Bible" href="https://play.google.com/store/apps/details?id=org.kalaam.cambodia.tampuan.tpu.bible&pcampaignid=web_share" appTitle="Tampuan Bible" developer="Kalaam Apps" />
            <StoreBadge type="youversion" name="the Tampuan Bible" href="https://www.bible.com/app" />
            <StoreBadge type="online" name="Tampuan Scripture" href="https://tampuan.ipsapps.org/km" />
            <StoreBadge type="bibleis" name="the Tampuan Bible" href="https://live.bible.is/bible/TPUWYI/LUK/1?audio_type=audio_drama" />
          </div>
          <hr class="resource-divider" />
          <div class="resource-actions store-badges">
            <StoreBadge type="site" name="Tampuan Scripture" href="https://tampuanreader.com/tpu" logo="/badges/icc.png" text="Tampuan Reader" />
          </div>
          </>
        )
      }
      {
        language.slug === "kuy" && (
          <div class="resource-actions store-badges">
            <StoreBadge type="youversion" name="the Kuy Bible" href="https://www.bible.com/bible/3295/GEN.1.KNT" />
            <StoreBadge type="bibleis" name="the Kuy Bible" href="https://live.bible.is/bible/KDTWYI/MRK/1?audio_type=audio_drama" />
          </div>
        )
      }
      {
        language.slug === "krung" && (
          <div class="resource-actions store-badges">
            <StoreBadge type="google" name="the Krung Bible" href="https://play.google.com/store/apps/details?id=org.emuinternational.krr.krungbible" appTitle="Krung Bible (ផាប់ គ្រែដៃ)" developer="EMU International" />
            <StoreBadge type="apple" name="the Krung Bible" href="https://apps.apple.com/us/app/krung-bible/id1462174340" />
            <StoreBadge type="online" name="the Krung Bible" href="https://krungbible.app/km" />
            <StoreBadge type="bibleis" name="the Krung Bible" href="https://live.bible.is/bible/KRRWBT/MAT/1?audio_type=audio" />
          </div>
        )
      }
    </article>
  </section>
</SiteLayout>
