---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="About Cambodia Bible"
  description="Learn about Cambodia Bible and its Scripture resources for minority languages in Cambodia."
  currentPath="/about/"
>
  <section class="content-section prose-section">
    <p class="eyebrow">About us</p>
    <h2>Scripture resources for Cambodia</h2>
    <p>
      Cambodia Bible produces and publishes Scripture apps and other resources 
      for minority languages of Cambodia. This site brings together resources 
      for Brao, Bunong, Cham, Jarai, Khmer, Kuy, Krung, and Tampuan.
    </p>
    <p>
      Choose a language from the <a href="/">home page</a> to see the resources
      currently available.
    </p>
  </section>
</SiteLayout>
